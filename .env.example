# These are already set inside docker-compose.yml for local dev.
# This file documents what to change when you move to real cloud services.

# --- Source DB (unchanged in prod: this stays your OLTP DB) ---
SOURCE_DB_HOST=postgres-source
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=news_source
SOURCE_DB_USER=news
SOURCE_DB_PASSWORD=news

# --- DWH: local Postgres now, BigQuery in prod (see dbt/profiles.yml.example) ---
DWH_DB_HOST=postgres-dwh
DWH_DB_PORT=5432
DWH_DB_NAME=news_dwh
DWH_DB_USER=news
DWH_DB_PASSWORD=news

# --- Lake: MinIO now, GCS in prod (swap in include/lake_storage.py) ---
LAKE_ENDPOINT_URL=http://minio:9000
LAKE_ACCESS_KEY=minioadmin
LAKE_SECRET_KEY=minioadmin

# --- Scraper: "fixture" for local testing, "live" once you wire a real API ---
SCRAPER_MODE=fixture

# --- Production-only (BigQuery + GCS) ---
# GCP_PROJECT=
# GCP_SERVICE_ACCOUNT_JSON=
# GCS_BUCKET=
